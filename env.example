# ============================================================================
# AuditAI — Environment Variables Template  (copy to .env.local / Vercel)
#
# HOW TO USE:
#   1. Dev (sandbox): real values -> .env.local (or Freebuff Settings -> Environment)
#   2. Production:    SAME keys    -> Vercel -> Settings -> Environment Variables
#   3. NEVER commit .env.local or real keys — only this template.
# ============================================================================

# ----------------------------------------------------------------------------
# Supabase  (REQUIRED — app will not start without these)
# Where: Supabase Dashboard -> Project Settings -> API
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only secret (bypasses RLS). Used by admin routes, AI chain, seeding.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct Postgres connection (OPTIONAL — only used by scripts/seed-*.js migrations)
SUPABASE_DB_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# ----------------------------------------------------------------------------
# AI Providers  (REQUIRED — at least DeepSeek; Gemini recommended as fallback)
# Built-ins run through the admin-configured provider chain (Admin -> AI
# Settings). On limit exhaustion it auto-fails-over to the next provider.
# ----------------------------------------------------------------------------
# Primary engine
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Fallback engine (auto-used when DeepSeek quota/rate-limit hits)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

# Legacy env chain (OPTIONAL — admin panel chain takes priority when set)
# AI_PRIMARY_PROVIDER=deepseek
# AI_FALLBACK_PROVIDER=gemini

# Optional: text matchers treated as "limit exhausted" -> failover (JSON array)
# AI_LIMIT_ERROR_MATCHERS=["429","rate limit","quota"]

# Custom AI providers: add unlimited via Admin -> AI Settings. For each one,
# give an apiKeyEnv name (e.g. GROQ_API_KEY, OPENROUTER_API_KEY,
# TOGETHER_API_KEY) and define that env var here or in Vercel. Example:
# GROQ_API_KEY=your-groq-api-key

# ----------------------------------------------------------------------------
# Storybook Illustrations + Voice  (REQUIRED for AI Storybooks)
#
# DIRECT providers — no mediator. Google Gemini does BOTH illustrations
# ("nano banana", gemini-2.5-flash-image) and voice narration (TTS) with the
# SAME GEMINI_API_KEY you already use for text. Leonardo is kept only as an
# automatic fallback for character likeness (optional).
# ----------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key
# Optional overrides (defaults shown):
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# Leonardo.Ai (OPTIONAL fallback — only needed if you flip the provider order
# to "leonardo" in Admin → Storybooks, or Gemini is unavailable)
# LEONARDO_API_KEY=your-leonardo-api-key

# ----------------------------------------------------------------------------
# Print-on-Demand — Lulu Direct Print API  (REQUIRED for printed copies)
# Where: lulu.com — developer console (api.lulu.com). Create one print-enabled
# product (A4-ish paperback), then set sandbox or production keys here.
# ----------------------------------------------------------------------------
POD_CLIENT_KEY=your-lulu-client-key
POD_CLIENT_SECRET=your-lulu-client-secret
# Webhook secret for live print/tracking status updates (set in Lulu's webhook
# settings alongside the URL /api/storybook/webhooks/pod)
POD_WEBHOOK_SECRET=your-webhook-secret
# Optional overrides:
# POD_PACKAGE_ID=PAGE_SIZE_866X1117_PBW

# ----------------------------------------------------------------------------
# PayPal Payments  (REQUIRED for credits checkout)
# Where: developer.paypal.com -> Apps & Credentials
# Sandbox credentials for testing, Live for production. Sandbox/Live mode is
# toggled in Admin -> Payments — secrets stay in env, never in DB.
# ----------------------------------------------------------------------------
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret

# ----------------------------------------------------------------------------
# Resend — Transactional Email  (REQUIRED for support/payout/payment emails)
# Where: resend.com -> API Keys
# ----------------------------------------------------------------------------
RESEND_API_KEY=your-resend-api-key
# "onboarding@resend.dev" only sends to YOUR own email while testing.
# After your custom domain is verified in Resend, change to:
# RESEND_FROM_EMAIL=AuditAI <noreply@yourdomain.com>
RESEND_FROM_EMAIL=AuditAI <onboarding@resend.dev>

# ----------------------------------------------------------------------------
# Site URL  (REQUIRED in production — Vercel + Render + Supabase emails)
#
# Used for: canonical URLs, sitemap.xml, OG share-cards, Storybook-ready
# emails, AND admin-resend verification links.
#
# Vercel  : Settings -> Environment Variables -> NEXT_PUBLIC_SITE_URL =
#           https://auditai-peach.vercel.app   (ya custom domain)
# Render  : Environment -> NEXT_PUBLIC_SITE_URL = same value
#
# IMPORTANT (Supabase Auth emails — the localhost:3000 fix):
#   Supabase Dashboard -> Authentication -> URL Configuration
#     - Site URL:      https://auditai-peach.vercel.app
#     - Redirect URLs: https://auditai-peach.vercel.app/**
#   Without this, signup/reset emails link to the default localhost —
#   this is Supabase-side config, not an app env var.
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://auditai-peach.vercel.app
